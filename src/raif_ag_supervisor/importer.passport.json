{
  "schema": "BPR40_SIDECAR_PASSPORT/1.1",
  "module_id": "importer",
  "name": "Importer",
  "version": "1.0.0",
  "standard": "SENIOR_ARCHITECTURE_STANDARD_V6.0",
  "layer": "tools",
  "description": "Pure validation of exported account manifests. Does not persist credentials.",
  "author": "RAIF_DEVELOPER",
  "inputs": {},
  "outputs": {},
  "invariants": [
    "SIDECAR_CANON_ENFORCED",
    "IN_CODE_ONLY_VERSION",
    "FAIL_CLOSED"
  ],
  "functions": {
    "parse_manifest": {
      "fn_id": "importer.parse_manifest",
      "description": "Parse entirely in memory; caller owns the sensitive return value.",
      "args": [
        "data"
      ],
      "inputs": {
        "data": {
          "type": "bytes",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "list[AccountRecord]"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "inspect_file": {
      "fn_id": "importer.inspect_file",
      "description": "Return only count; do not print, serialize or log account content.",
      "args": [
        "path"
      ],
      "inputs": {
        "path": {
          "type": "Path",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "int"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    }
  }
}