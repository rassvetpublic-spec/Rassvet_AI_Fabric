      "fn_id": "importer.parse_manifest",
      "description": "Parse entirely in memory; caller owns the sensitive return value.",
      "args": [
        "data"
      ],
      "inputs": {
        "data": {
          "type": "bytes",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "list[AccountRecord]"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "inspect_file": {
      "fn_id": "importer.inspect_file",
      "description": "Return only count; do not print, serialize or log account content.",
      "args": [
        "path"
      ],
      "inputs": {
        "path": {
          "type": "Path",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "int"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    }
  },
