{
  "schema": "BPR40_SIDECAR_PASSPORT/1.1",
  "module_id": "foreground_w2",
  "name": "W2 / 10.5 Foreground Synthetic Worker",
  "version": "0.1.0",
  "standard": "SENIOR_ARCHITECTURE_STANDARD_V6.0",
  "layer": "core",
  "description": "Windows-only foreground worker: cancellation, durable effect evidence and no replay.",
  "author": "RAIF_DEVELOPER",
  "inputs": {},
  "outputs": {},
  "invariants": [
    "SIDECAR_CANON_ENFORCED",
    "IN_CODE_ONLY_VERSION",
    "FAIL_CLOSED",
    "SYNTHETIC_ONLY"
  ],
  "functions": {
    "_summary": {
      "fn_id": "foreground_w2._summary",
      "description": "Публичный результат без аренды, исходного payload, путей и PID.",
      "args": [
        "store",
        "ledger",
        "task_id",
        "target_id",
        "operation_id",
        "reason"
      ],
      "inputs": {
        "store": {
          "type": "FabricStore",
          "required": true,
          "default": null
        },
        "ledger": {
          "type": "EffectLedger",
          "required": true,
          "default": null
        },
        "task_id": {
          "type": "str",
          "required": true,
          "default": null
        },
        "target_id": {
          "type": "str",
          "required": true,
          "default": null
        },
        "operation_id": {
          "type": "str",
          "required": true,
          "default": null
        },
        "reason": {
          "type": "str",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "dict"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "_settle_blocked": {
      "fn_id": "foreground_w2._settle_blocked",
      "description": "Только fail-closed завершение; если lease потерян, потребуется recovery.",
      "args": [
        "store",
        "ledger",
        "task_id",
        "owner",
        "lease_token",
        "reason"
      ],
      "inputs": {
        "store": {
          "type": "FabricStore",
          "required": true,
          "default": null
        },
        "ledger": {
          "type": "EffectLedger",
          "required": true,
          "default": null
        },
        "task_id": {
          "type": "str",
          "required": true,
          "default": null
        },
        "owner": {
          "type": "str",
          "required": true,
          "default": null
        },
        "lease_token": {
          "type": "str",
          "required": true,
          "default": null
        },
        "reason": {
          "type": "str",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "None"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "run_foreground_synthetic_once": {
      "fn_id": "foreground_w2.run_foreground_synthetic_once",
      "description": "Одна synthetic mock-задача с fenced PREPARED→MAY_HAVE_RUN→receipt.",
      "args": [
        "store",
        "target",
        "operation_id",
        "payload_sha256",
        "case",
        "timeout_seconds",
        "task_id",
        "owner"
      ],
      "inputs": {
        "store": {
          "type": "FabricStore",
          "required": true,
          "default": null
        },
        "target": {
          "type": "SyntheticSQLiteTarget",
          "required": true,
          "default": null
        },
        "operation_id": {
          "type": "str",
          "required": true,
          "default": null
        },
        "payload_sha256": {
          "type": "str",
          "required": true,
          "default": null
        },
        "case": {
          "type": "str",
          "required": false,
          "default": "'EXIT_ZERO'"
        },
        "timeout_seconds": {
          "type": "float",
          "required": false,
          "default": "3.0"
        },
        "task_id": {
          "type": "str | None",
          "required": false,
          "default": "None"
        },
        "owner": {
          "type": "str | None",
          "required": false,
          "default": "None"
        }
      },
      "outputs": {
        "return_type": "dict"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "recover_foreground_synthetic": {
      "fn_id": "foreground_w2.recover_foreground_synthetic",
      "description": "Без replay: истёкшие аренды → BLOCKED и UNKNOWN_OUTCOME.",
      "args": [
        "store"
      ],
      "inputs": {
        "store": {
          "type": "FabricStore",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "dict"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    }
  }
}