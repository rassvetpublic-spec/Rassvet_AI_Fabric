{
  "schema": "BPR40_SIDECAR_PASSPORT/1.1",
  "module_id": "distributed_pool",
  "name": "Distributed Pool",
  "version": "1.0.0",
  "standard": "SENIOR_ARCHITECTURE_STANDARD_V6.0",
  "layer": "tools",
  "description": "rai_fabric.distributed_pool - Распределённый пул воркеров и RPC-маршрутизатор инференса (Stage R0.6).",
  "author": "RAIF_DEVELOPER",
  "inputs": {},
  "outputs": {},
  "invariants": [
    "SIDECAR_CANON_ENFORCED",
    "IN_CODE_ONLY_VERSION",
    "FAIL_CLOSED"
  ],
  "functions": {
    "WeightedLoadBalancer.score_worker": {
      "fn_id": "distributed_pool.WeightedLoadBalancer.score_worker",
      "description": "Формула скоринга воркера:",
      "args": [
        "vram_free_mb",
        "compute_power",
        "active_tasks",
        "task_tokens"
      ],
      "inputs": {
        "vram_free_mb": {
          "type": "float",
          "required": true,
          "default": null
        },
        "compute_power": {
          "type": "float",
          "required": true,
          "default": null
        },
        "active_tasks": {
          "type": "int",
          "required": true,
          "default": null
        },
        "task_tokens": {
          "type": "int",
          "required": false,
          "default": "1000"
        }
      },
      "outputs": {
        "return_type": "float"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "DistributedWorkerPool.registered_workers_count": {
      "fn_id": "distributed_pool.DistributedWorkerPool.registered_workers_count",
      "description": "Функция DistributedWorkerPool.registered_workers_count",
      "args": [],
      "inputs": {},
      "outputs": {
        "return_type": "int"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "DistributedWorkerPool.register_worker": {
      "fn_id": "distributed_pool.DistributedWorkerPool.register_worker",
      "description": "Регистрация воркера в пуле с аппаратным профилем.",
      "args": [
        "worker_id",
        "capabilities",
        "endpoint",
        "vram_free_mb",
        "compute_power"
      ],
      "inputs": {
        "worker_id": {
          "type": "str",
          "required": true,
          "default": null
        },
        "capabilities": {
          "type": "Optional[List[str]]",
          "required": false,
          "default": "None"
        },
        "endpoint": {
          "type": "Optional[str]",
          "required": false,
          "default": "None"
        },
        "vram_free_mb": {
          "type": "float",
          "required": false,
          "default": "8000.0"
        },
        "compute_power": {
          "type": "float",
          "required": false,
          "default": "1.0"
        }
      },
      "outputs": {
        "return_type": "bool"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "DistributedWorkerPool.unregister_worker": {
      "fn_id": "distributed_pool.DistributedWorkerPool.unregister_worker",
      "description": "Исключение воркера из пула.",
      "args": [
        "worker_id"
      ],
      "inputs": {
        "worker_id": {
          "type": "str",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "bool"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "DistributedWorkerPool.select_best_worker": {
      "fn_id": "distributed_pool.DistributedWorkerPool.select_best_worker",
      "description": "Выбор лучшего воркера с использованием взвешенного скоринга (R7).",
      "args": [
        "required_capability",
        "task_tokens"
      ],
      "inputs": {
        "required_capability": {
          "type": "str",
          "required": false,
          "default": "'inference'"
        },
        "task_tokens": {
          "type": "int",
          "required": false,
          "default": "1000"
        }
      },
      "outputs": {
        "return_type": "Optional[str]"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "DistributedWorkerPool.enqueue_worker_task": {
      "fn_id": "distributed_pool.DistributedWorkerPool.enqueue_worker_task",
      "description": "Помещение задачи в очередь конкретного воркера.",
      "args": [
        "worker_id",
        "task"
      ],
      "inputs": {
        "worker_id": {
          "type": "str",
          "required": true,
          "default": null
        },
        "task": {
          "type": "Dict[str, Any]",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "bool"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "DistributedWorkerPool.steal_work": {
      "fn_id": "distributed_pool.DistributedWorkerPool.steal_work",
      "description": "Проактивный перехват задачи из хвоста наиболее загруженного воркера (Work-Stealing / R7).",
      "args": [
        "idle_worker_id"
      ],
      "inputs": {
        "idle_worker_id": {
          "type": "str",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "Optional[Dict[str, Any]]"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "DistributedWorkerPool.dispatch_inference_task": {
      "fn_id": "distributed_pool.DistributedWorkerPool.dispatch_inference_task",
      "description": "Маршрутизация задачи инференса в распределённый пул.",
      "args": [
        "prompt",
        "task_id",
        "priority"
      ],
      "inputs": {
        "prompt": {
          "type": "str",
          "required": true,
          "default": null
        },
        "task_id": {
          "type": "Optional[str]",
          "required": false,
          "default": "None"
        },
        "priority": {
          "type": "int",
          "required": false,
          "default": "1"
        }
      },
      "outputs": {
        "return_type": "Dict[str, Any]"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "DistributedWorkerPool.get_pool_status": {
      "fn_id": "distributed_pool.DistributedWorkerPool.get_pool_status",
      "description": "Получение агрегированного состояния пула.",
      "args": [],
      "inputs": {},
      "outputs": {
        "return_type": "Dict[str, Any]"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    }
  }
}