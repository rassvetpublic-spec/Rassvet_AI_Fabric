  "name": "Oauth Identity",
  "version": "1.0.0",
  "standard": "SENIOR_ARCHITECTURE_STANDARD_V6.0",
  "layer": "tools",
  "description": "Проверка OpenID Connect ID-токена на доверенных JWKS без сетевых запросов.",
