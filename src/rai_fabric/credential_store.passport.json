{
  "schema": "BPR40_SIDECAR_PASSPORT/1.1",
  "module_id": "credential_store",
  "name": "Credential Store",
  "version": "1.0.0",
  "standard": "SENIOR_ARCHITECTURE_STANDARD_V6.0",
  "layer": "tools",
  "description": "Атомарное хранение проверенной OAuth-сессии под DPAPI текущего Windows SID.",
  "author": "RAIF_DEVELOPER",
  "inputs": {},
  "outputs": {},
  "invariants": [
    "SIDECAR_CANON_ENFORCED",
    "IN_CODE_ONLY_VERSION",
    "FAIL_CLOSED"
  ],
  "functions": {
    "_validate_credential": {
      "fn_id": "credential_store._validate_credential",
      "description": "Функция _validate_credential",
      "args": [
        "identity",
        "value"
      ],
      "inputs": {
        "identity": {
          "type": "VerifiedIdentity",
          "required": true,
          "default": null
        },
        "value": {
          "type": "Mapping[str, Any]",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "dict[str, Any]"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "_parse_envelope": {
      "fn_id": "credential_store._parse_envelope",
      "description": "Функция _parse_envelope",
      "args": [
        "data",
        "identity"
      ],
      "inputs": {
        "data": {
          "type": "bytes",
          "required": true,
          "default": null
        },
        "identity": {
          "type": "VerifiedIdentity",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "LoadedCredential"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    }
  }
}