  "functions": {
    "credential_record_key": {
      "fn_id": "windows_vault.credential_record_key",
      "description": "Обезличенное имя записи; не выводит почту, subject или OAuth-токены.",
      "args": [
        "client_id",
        "subject",
        "issuer"
      ],
      "inputs": {
        "client_id": {
          "type": "str",
          "required": true,
          "default": null
        },
        "subject": {
          "type": "str",
          "required": true,
          "default": null
        },
        "issuer": {
          "type": "str",
          "required": false,
          "default": "ISSUER"
        }
      },
      "outputs": {
        "return_type": "str"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "default_vault_root": {
      "fn_id": "windows_vault.default_vault_root",
      "description": "Только рассчитывает путь под профилем Windows; ничего не создаёт.",
      "args": [
        "local_appdata"
      ],
      "inputs": {
        "local_appdata": {
          "type": "str | None",
          "required": false,
          "default": "None"
        }
      },
      "outputs": {
        "return_type": "Path"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "WindowsUserDPAPI.protect": {
      "fn_id": "windows_vault.WindowsUserDPAPI.protect",
      "description": "Шифрует данные пользователя; запрещён режим шифрования всей машины.",
      "args": [
        "plaintext"
      ],
      "inputs": {
        "plaintext": {
          "type": "bytes",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "bytes"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    },
    "WindowsUserDPAPI.unprotect": {
      "fn_id": "windows_vault.WindowsUserDPAPI.unprotect",
      "description": "Расшифровывает только при наличии исходного контекста пользователя.",
      "args": [
        "encrypted"
      ],
      "inputs": {
        "encrypted": {
          "type": "bytes",
          "required": true,
          "default": null
        }
      },
      "outputs": {
        "return_type": "bytes"
      },
      "invariants": [
        "FAIL_CLOSED",
        "DETERMINISTIC"
      ]
    }
